{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Batch all GitHub Actions bumps into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Batch non-major Go module bumps, except the etcd/gRPC write path",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["*", "!google.golang.org/grpc", "!go.etcd.io/etcd/**"],
      "groupName": "go modules (non-major)"
    }
  ]
}
